    {
      "parameters": {
        "jsCode": "const r0 = $('Postgres suporte.api').first().json.r || {};\nconst codigos = r0.ocorr_codigos || [];\nconst objs = $input.all().map(i => i.json || {});\nconst parse = (v) => { if (typeof v !== 'string') return v; try { return JSON.parse(v); } catch (e) { return v; } };\nconst ocorrencias = [];\nfor (const codigo of codigos) {\n  const registros = {};\n  for (const o of objs) {\n    for (const [k, v] of Object.entries(o)) {\n      if (k.startsWith('painel:') && k.endsWith(':' + codigo)) registros[k.slice(7, -(codigo.length + 1))] = parse(v);\n    }\n  }\n  if (Object.keys(registros).length) ocorrencias.push({ codigo, registros });\n}\nreturn [{ json: { r: { ok: true, ocorrencias } } }];"
      },
