                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "32e038f4-fe17-47ed-812d-ffa58cbeb602",
      "name": "Consulta Frenet?",
