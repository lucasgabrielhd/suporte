      "id": "b8746075-4c35-48b3-81b0-91387e85a578",
      "name": "Frenet rastreio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        60
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "N1PYeH534gvjLZrk",
          "name": "Frenet Face Clean"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const alvo = $('Postgres suporte.api').first().json.r || {};\nconst resp = $input.first().json || {};\nconst toIso = (s) => {\n  const t = String(s || '').trim();\n  const m = t.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})[ T]?(\\d{2}:\\d{2}(?::\\d{2})?)?/);\n  if (m) return `${m[3]}-${m[2]}-${m[1]}T${m[4] || '00:00'}-03:00`;\n  return t;\n};\nconst lista = Array.isArray(resp.TrackingEvents) ? resp.TrackingEvents : [];\nconst eventos = lista.map(e => ({\n  quando: toIso(e.EventDateTime),\n  local: e.EventLocation || '',\n  descricao: e.EventDescription || '',\n  tipo: e.EventType || ''\n})).sort((a, b) => (Date.parse(b.quando) || 0) - (Date.parse(a.quando) || 0)).slice(0, 20);\nlet erro = resp.ErrorMessage || '';\nif (!erro && resp.error) erro = resp.error.message || String(resp.error);\nif (!erro && !eventos.length) erro = 'sem_eventos';\nconst dados = { ok: eventos.length > 0, erro, url: resp.TrackingUrl || '', servico: resp.ServiceDescrition || '', eventos };\nconst json = JSON.stringify({ rota: 'rastreio_salvar', token: '', body: { codigo: alvo.codigo, dados } });\nconst b64 = typeof Buffer !== 'undefined'\n  ? Buffer.from(json, 'utf8').toString('base64')\n  : btoa(unescape(encodeURIComponent(json)));\nreturn [{ json: { sql: `select suporte.api(convert_from(decode('${b64}', 'base64'), 'UTF8')::jsonb) as r` } }];"
      },
