    {
      "parameters": {
        "jsCode": "let rota = '';\nif ($('App envia (in)').isExecuted) rota = 'in';\nelse if ($('App busca (out)').isExecuted) rota = 'out';\nelse if ($('Painel (api)').isExecuted) rota = 'painel';\nconst req = $input.first().json || {};\nlet body = {};\nlet token = '';\nif (rota === 'in' || rota === 'out') {\n  body = req.body || {};\n} else if (rota === 'painel') {\n  const raw = req.body && typeof req.body.d === 'string' ? req.body.d : '{}';\n  try { body = JSON.parse(raw); } catch (e) { body = {}; }\n  token = String(body.token || '');\n  delete body.token;\n}\nconst json = JSON.stringify({ rota, token, body });\nconst b64 = typeof Buffer !== 'undefined'\n  ? Buffer.from(json, 'utf8').toString('base64')\n  : btoa(unescape(encodeURIComponent(json)));\nreturn [{ json: { rota, sql: `select suporte.api(convert_from(decode('${b64}', 'base64'), 'UTF8')::jsonb) as r` } }];"
      },
